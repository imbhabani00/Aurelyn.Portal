@* Replace "dynamic" with your profile model, e.g.
   @model Aurelyn.Portal.Models.User.UserProfileViewModel
   Properties used: FullName, Email, PhoneNumber, Initials, TenantId *@
@model dynamic
@{
    bool hasProfile = Model != null;
    string fullName = hasProfile ? (string)Model.FullName : "";
    string email = hasProfile ? (string)Model.Email : "";
    string phone = hasProfile ? (string)Model.PhoneNumber : "";
    string initials = hasProfile ? (string)Model.Initials : "";
    string role = ViewData["RoleName"]?.ToString() ?? "";
}

@if (!hasProfile)
{
    <div class="au-empty-state">
        <h4>Profile unavailable</h4>
        <p class="mb-0">We couldn't load your profile. Close this window and try again.</p>
    </div>
}
else
{
    <style>
        .pf-head {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 18px;
        }

        .pf-avatar {
            width: 68px;
            height: 68px;
            flex: 0 0 68px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            color: #fff;
            font-size: 22px;
            font-weight: 800;
            background: linear-gradient(145deg,#8884ff,#504bd1);
            box-shadow: 5px 5px 12px #c4c7ee, -4px -4px 10px #fff;
        }

        .pf-name {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
        }

        .pf-list {
            display: grid;
            gap: 10px;
        }

        .pf-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 14px;
            background: #f3f4ff;
            box-shadow: var(--au-inset);
        }

        .pf-ico {
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            color: var(--au-primary);
            background: #f3f4ff;
            box-shadow: var(--au-shadow-small);
        }

            .pf-ico svg {
                width: 16px;
                height: 16px;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .pf-label {
            display: block;
            font-size: 10px;
            font-weight: 700;
            color: var(--au-muted);
        }

        .pf-value {
            display: block;
            margin-top: 2px;
            font-size: 12px;
            font-weight: 700;
            word-break: break-word;
        }
    </style>

    <div class="pf-head">
        <div class="pf-avatar">@initials</div>
        <div>
            <h3 class="pf-name">@fullName</h3>
            @if (!string.IsNullOrWhiteSpace(role))
            {
                <span class="au-badge au-badge-info mt-1">@role</span>
            }
        </div>
    </div>

    <div class="pf-list">
        <div class="pf-row">
            <span class="pf-ico"><svg viewBox="0 0 24 24"><use href="#au-user" /></svg></span>
            <div><span class="pf-label">Full name</span><span class="pf-value">@fullName</span></div>
        </div>
        <div class="pf-row">
            <span class="pf-ico"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg></span>
            <div><span class="pf-label">Email address</span><span class="pf-value">@email</span></div>
        </div>
        <div class="pf-row">
            <span class="pf-ico"><svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg></span>
            <div><span class="pf-label">Phone number</span><span class="pf-value">@(string.IsNullOrWhiteSpace(phone) ? "—" : phone)</span></div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="au-btn au-btn-secondary" onclick="closePopup()">Close</button>
        <button type="button" class="au-btn au-btn-primary" onclick="loadPopup('@Url.Action("ChangePassword", "User")','Change Password','md')">Change password</button>
    </div>
}
