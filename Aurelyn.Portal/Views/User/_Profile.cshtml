@model Aurelyn.Portal.Models.User.UserDetails

@{
    ViewData["Title"] = "My Profile";
    ViewData["ActiveMenu"] = "Profile";
}

<style>
    .pf {
        --pf-line: rgba(255,255,255,.10);
        --pf-soft: rgba(255,255,255,.06);
        --pf-text-dim: rgba(255,255,255,.60);
        --pf-primary: var(--au-primary, #7c83ff);
        --pf-ok: #34d399;
        --pf-warn: #fbbf24;
        --pf-bad: #fb7185;
        display: grid;
        gap: 16px;
        color: inherit;
    }

        .pf *, .pf *::before, .pf *::after {
            box-sizing: border-box;
        }

    /* Glass card */
    .pf-card {
        position: relative;
        overflow: hidden;
        border-radius: 26px;
        padding: 22px 24px;
        border: 1px solid var(--pf-line);
        background: linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.02));
        box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 20px 40px -20px rgba(0,0,0,.6);
    }

        .pf-card::after {
            content: "";
            position: absolute;
            left: -10%;
            right: -10%;
            bottom: -60px;
            height: 140px;
            background: radial-gradient(60% 100% at 50% 100%, rgba(124,131,255,.28), transparent 70%);
            pointer-events: none;
        }

        .pf-card > * {
            position: relative;
            z-index: 1;
        }

    /* Header */
    .pf-avatar {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        overflow: hidden;
        font-size: 28px;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(145deg,#8884ff,#504bd1);
        box-shadow: 0 0 0 4px rgba(124,131,255,.18), 0 10px 24px -8px rgba(80,75,209,.7);
    }

        .pf-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .pf-name {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.15;
        margin-top: 14px;
        letter-spacing: -.01em;
    }

    .pf-role {
        font-size: 1rem;
        color: var(--pf-text-dim);
        margin-top: 2px;
    }

    .pf-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
    }

    .pf-chip {
        display: inline-flex;
        align-items: center;
        font-size: .74rem;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 999px;
        background: var(--pf-soft);
        border: 1px solid var(--pf-line);
        white-space: nowrap;
    }

        .pf-chip.ok {
            background: rgba(52,211,153,.14);
            border-color: rgba(52,211,153,.35);
            color: var(--pf-ok);
        }

        .pf-chip.warn {
            background: rgba(251,191,36,.14);
            border-color: rgba(251,191,36,.35);
            color: var(--pf-warn);
        }

        .pf-chip.bad {
            background: rgba(251,113,133,.14);
            border-color: rgba(251,113,133,.35);
            color: var(--pf-bad);
        }

    /* Stats */
    .pf-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: 22px;
    }

    .pf-stat {
        text-align: center;
        padding: 4px 8px;
    }

        .pf-stat + .pf-stat {
            border-left: 1px solid var(--pf-line);
        }

        .pf-stat b {
            display: block;
            font-size: 1.15rem;
            font-weight: 700;
        }

        .pf-stat span {
            display: block;
            font-size: .8rem;
            color: var(--pf-text-dim);
            margin-top: 2px;
        }

        .pf-stat b.ok {
            color: var(--pf-ok);
        }

        .pf-stat b.warn {
            color: var(--pf-warn);
        }

    .pf-bar {
        height: 4px;
        border-radius: 999px;
        background: var(--pf-soft);
        overflow: hidden;
        margin: 8px auto 0;
        max-width: 120px;
    }

        .pf-bar i {
            display: block;
            height: 100%;
            width: 0;
            border-radius: 999px;
            background: var(--pf-bad);
            transition: width .6s ease, background .3s;
        }

    /* Pending pills */
    .pf-todo {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-top: 18px;
        font-size: .78rem;
    }

        .pf-todo > span {
            color: var(--pf-text-dim);
        }

    .pf-pill {
        border: 1px dashed rgba(251,191,36,.6);
        background: rgba(251,191,36,.08);
        color: inherit;
        border-radius: 999px;
        padding: 3px 12px;
        font-size: .74rem;
        cursor: pointer;
    }

        .pf-pill b {
            margin-left: 6px;
            color: var(--pf-warn);
        }

        .pf-pill:hover {
            background: rgba(251,191,36,.18);
        }

    .pf-done {
        color: var(--pf-ok);
        font-weight: 600;
    }

    /* Form */
    .pf-title {
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--pf-text-dim);
        margin: 0 0 14px;
    }

    .pf-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 14px 16px;
    }

    .pf-full {
        grid-column: 1 / -1;
    }

    .pf-field {
        min-width: 0;
    }

    .pf-lbl {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        height: 24px;
        margin-bottom: 4px;
    }

        .pf-lbl label {
            margin: 0;
            font-size: .78rem;
            font-weight: 600;
        }

            .pf-lbl label b {
                color: var(--pf-bad);
            }

    .pf-vwrap {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .pf-vwrap .pf-chip {
            padding: 1px 9px;
            font-size: .68rem;
        }

    .pf-field input {
        display: block;
        width: 100%;
        height: 42px;
        padding: 0 14px;
        border-radius: 14px;
        border: 1px solid var(--pf-line);
        background: rgba(255,255,255,.05);
        color: inherit;
        outline: 0;
        font: inherit;
        font-size: .9rem;
        transition: border-color .2s, box-shadow .2s;
    }

        .pf-field input::placeholder {
            color: rgba(255,255,255,.35);
        }

        .pf-field input:focus {
            border-color: var(--pf-primary);
            box-shadow: 0 0 0 3px rgba(124,131,255,.22);
        }

        .pf-field input[readonly] {
            opacity: .7;
            cursor: default;
        }

    .pf-field.missing input {
        border-color: rgba(251,191,36,.6);
    }

    .pf-field.invalid input {
        border-color: var(--pf-bad);
    }

    .pf-err {
        display: block;
        min-height: 16px;
        margin-top: 3px;
        font-size: .72rem;
        color: var(--pf-bad);
    }

    /* Account tiles */
    .pf-tile {
        padding: 12px 16px;
        border-radius: 16px;
        background: var(--pf-soft);
        border: 1px solid var(--pf-line);
        min-width: 0;
    }

        .pf-tile small {
            display: block;
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--pf-text-dim);
            margin-bottom: 3px;
        }

        .pf-tile div {
            font-size: .92rem;
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    /* Buttons */
    .pf-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .pf-btn {
        height: 46px;
        padding: 0 28px;
        border-radius: 999px;
        font-weight: 700;
        font-size: .9rem;
        cursor: pointer;
        border: 1px solid transparent;
        color: inherit;
        transition: transform .15s, box-shadow .2s, opacity .2s;
    }

        .pf-btn:active {
            transform: scale(.97);
        }

        .pf-btn:disabled {
            opacity: .45;
            cursor: not-allowed;
            pointer-events: none;
        }

        .pf-btn.cancel {
            background: rgba(255,255,255,.06);
            border-color: var(--pf-line);
        }

            .pf-btn.cancel:hover {
                background: rgba(255,255,255,.12);
            }

        .pf-btn.save {
            background: linear-gradient(145deg,#8f95ff,#5a55e0);
            color: #fff;
            box-shadow: 0 10px 24px -8px rgba(90,85,224,.8);
        }

    @@media (max-width: 767px) {
        .pf-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 480px) {
        .pf-grid {
            grid-template-columns: 1fr;
        }

        .pf-stats {
            grid-template-columns: 1fr;
        }

        .pf-stat + .pf-stat {
            border-left: 0;
            border-top: 1px solid var(--pf-line);
            margin-top: 8px;
            padding-top: 12px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .pf-bar i, .pf-btn, .pf-field input {
            transition: none;
        }
    }

    #modalClose:disabled {
        opacity: .4 !important;
        cursor: not-allowed !important;
        pointer-events: none !important;
    }

    .pf-avatar-wrap {
        position: relative;
        width: 84px;
        height: 84px;
    }

        .pf-avatar-wrap .pf-avatar {
            width: 100%;
            height: 100%;
        }

    .pf-avatar img[hidden] {
        display: none;
    }

    .pf-camera-btn {
        position: absolute;
        right: -2px;
        bottom: -2px;
        width: 30px;
        height: 30px;
        padding: 0;
        border-radius: 50%;
        border: 2px solid #14142b;
        background: var(--pf-primary);
        color: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        z-index: 2;
    }

        .pf-camera-btn svg {
            width: 15px;
            height: 15px;
        }

        .pf-camera-btn:hover {
            filter: brightness(1.1);
        }

    .pf-modal {
        position: fixed;
        inset: 0;
        z-index: 2000;
        background: rgba(0,0,0,.6);
        display: grid;
        place-items: center;
        padding: 16px;
    }

        .pf-modal[hidden] {
            display: none;
        }

    .pf-modal-box {
        max-width: 420px;
    }

    .pf-crop {
        width: 100%;
        height: 300px;
        background: #0d0d1f;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 12px;
    }

        .pf-crop img {
            display: block;
            max-width: 100%;
        }

        .pf-crop .cropper-view-box, .pf-crop .cropper-face {
            border-radius: 50%;
        }
    /* circular crop look */
</style>

<div class="pf" id="pfRoot">
    <!-- Profile Header -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <div class="pf-card">

        <div class="pf-avatar-wrap">
                @{
                    var hasPic = !string.IsNullOrWhiteSpace(Model.ProfilePictureUrl);
                }

            <div class="pf-avatar" id="pfAvatar">
                <img id="pfImg" alt="Profile picture"
                     src="@(hasPic ? Model.ProfilePictureUrl : null)"
                @(hasPic ? "" : "hidden") />
                <span id="pfInitials" @(hasPic ? "hidden" : "")>@Model.Initials</span>
            </div>

            <button type="button" class="pf-camera-btn" id="pfCameraBtn" title="Change profile picture" aria-label="Change profile picture">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                    <circle cx="12" cy="13" r="4" />
                </svg>
            </button>

            <input type="file" id="pfFileInput" accept="image/png,image/jpeg,image/webp" hidden />
        </div>

        <div class="pf-name" id="pfFullName">@Model.FullName</div>
        <div class="pf-role" id="pfRole">@Model.RoleName</div>

        <div class="pf-tags">
            <span class="pf-chip" id="pfStatusChip">@Model.AccountStatus</span>

            <span class="pf-chip @(Model.IsActive ? "ok" : "bad")" id="pfActiveChip">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </div>

        <div class="pf-stats" role="status" aria-live="polite">

            <div class="pf-stat">
                <b id="pfPct">0%</b>
                <span>Profile completion</span>
                <div class="pf-bar">
                    <i id="pfFill"></i>
                </div>
            </div>

            <div class="pf-stat">
                <b class="@(Model.EmailVerified ? "ok" : "warn")">
                    @(Model.EmailVerified ? "Verified" : "Not verified")
                </b>
                <span>Email</span>
            </div>

            <div class="pf-stat">
                <b>@Model.CreatedDate.ToString("dd MMM yyyy")</b>
                <span>Member since</span>
            </div>

        </div>


        <div class="pf-todo" id="pfChecklist"></div>

    </div>

    <form id="pfForm" novalidate autocomplete="off" style="display:grid;gap:16px">

        @Html.AntiForgeryToken()

        <!-- Personal Details -->
        <div class="pf-card">

            <h4 class="pf-title">Personal details</h4>

            <div class="pf-grid">

                <div class="pf-field" data-key="firstName">
                    <div class="pf-lbl">
                        <label for="firstName">First name <b>*</b></label>
                    </div>
                    <input id="firstName" name="firstName"
                           value="@Model.FirstName"
                           maxlength="100"
                           autocomplete="given-name" />
                    <small class="pf-err"></small>
                </div>

                <div class="pf-field" data-key="middleName">
                    <div class="pf-lbl">
                        <label for="middleName">Middle name</label>
                    </div>
                    <input id="middleName" name="middleName"
                           value="@Model.MiddleName"
                           maxlength="100" />
                    <small class="pf-err"></small>
                </div>

                <div class="pf-field" data-key="lastName">
                    <div class="pf-lbl">
                        <label for="lastName">Last name <b>*</b></label>
                    </div>
                    <input id="lastName" name="lastName"
                           value="@Model.LastName"
                           maxlength="100"
                           autocomplete="family-name" />
                    <small class="pf-err"></small>
                </div>

                <!-- Email: Already verified -->
                <div class="pf-field" data-key="email">
                    <div class="pf-lbl">
                        <label for="email">Email address <b>*</b></label>
                        <span class="pf-chip @(Model.EmailVerified ? "ok" : "warn")">
                            @(Model.EmailVerified ? "Verified" : "Not verified")
                        </span>
                    </div>

                    <input id="email" name="email" type="email"
                           value="@Model.Email" maxlength="256" autocomplete="email" />
                    <small class="pf-err"></small>
                </div>

                <!-- Phone: No verification required -->
                <div class="pf-field" data-key="phoneNumber">
                    <div class="pf-lbl">
                        <label for="phoneNumber">Phone number <b>*</b></label>
@*                         <span class="pf-chip ok">Added</span>
 *@                    </div>

                    <input id="phoneNumber" name="phoneNumber"
                           type="tel"
                           value="@Model.PhoneNumber"
                           maxlength="16"
                           placeholder="+91XXXXXXXXXX"
                           autocomplete="tel" />

                    <small class="pf-err"></small>
                </div>
            </div>
        </div>

        <!-- Address -->
        <div class="pf-card">

            <h4 class="pf-title">Address</h4>

            <div class="pf-grid">

                <div class="pf-field" data-key="addressLine1">
                    <div class="pf-lbl">
                        <label for="addressLine1">Address line 1 <b>*</b></label>
                    </div>

                    <input id="addressLine1" name="addressLine1"
                           value="@Model.AddressLine1"
                           maxlength="200"
                           placeholder="House / street"
                           autocomplete="address-line1" />

                    <small class="pf-err"></small>
                </div>

                <div class="pf-field" data-key="addressLine2">
                    <div class="pf-lbl">
                        <label for="addressLine2">Address line 2</label>
                    </div>

                    <input id="addressLine2" name="addressLine2"
                           value="@Model.AddressLine2"
                           maxlength="200"
                           placeholder="Area / landmark (optional)"
                           autocomplete="address-line2" />

                    <small class="pf-err"></small>
                </div>

                <div class="pf-field" data-key="city">
                    <div class="pf-lbl">
                        <label for="city">City <b>*</b></label>
                    </div>

                    <input id="city" name="city"
                           value="@Model.City"
                           maxlength="100"
                           autocomplete="address-level2" />

                    <small class="pf-err"></small>
                </div>

                <div class="pf-field" data-key="region">
                    <div class="pf-lbl">
                        <label for="region">State / Province <b>*</b></label>
                    </div>

                    <input id="region" name="state"
                           value="@Model.State"
                           maxlength="100"
                           autocomplete="address-level1" />

                    <small class="pf-err"></small>
                </div>

                <div class="pf-field" data-key="zipCode">
                    <div class="pf-lbl">
                        <label for="zipCode">ZIP / Postal code <b>*</b></label>
                    </div>

                    <input id="zipCode" name="zipCode"
                           value="@Model.ZipCode"
                           maxlength="10"
                           autocomplete="postal-code" />

                    <small class="pf-err"></small>
                </div>

                <div class="pf-field" data-key="country">
                    <div class="pf-lbl">
                        <label for="country">Country <b>*</b></label>
                    </div>

                    <input id="country" name="country"
                           value="@Model.Country"
                           maxlength="100"
                           autocomplete="country-name" />

                    <small class="pf-err"></small>
                </div>

            </div>
        </div>

        <!-- Account Information -->
        <div class="pf-card">

            <h4 class="pf-title">Account information</h4>

            <div class="pf-grid">

                <div class="pf-tile">
                    <small>Role</small>
                    <div id="inRoleName">@Model.RoleName</div>
                </div>

                <div class="pf-tile">
                    <small>Account status</small>
                    <div id="inStatus">@Model.AccountStatus</div>
                </div>

                <div class="pf-tile">
                    <small>Is active</small>
                    <div id="inActive">@(Model.IsActive ? "Yes" : "No")</div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="pf-actions">
            <button type="submit"
                    class="pf-btn save"
                    id="pfSave"
                    >
                Save changes
            </button>

        </div>

    </form>
</div>

<div class="pf-modal" id="pfPicModal" hidden>
    <div class="pf-modal-box">
        <h4 class="pf-title">Crop profile picture</h4>
        <div class="pf-crop"><img id="pfPreviewImg" alt="Crop" /></div>
        <small class="pf-err" id="pfPicMsg"></small>
        <div class="pf-actions">
            <button type="button" class="pf-btn cancel" id="pfPicCancel">Cancel</button>
            <button type="button" class="pf-btn save" id="pfPicUpload">Upload</button>
        </div>
    </div>
</div>

<script>
    window.PROFILE = @Html.Raw(Json.Serialize(Model));
    window.PF_URLS = {
        update: '@Url.Action("UpdateProfile", "User")',
        updateProfilePicture: '@Url.Action("UpdateProfilePicture", "User")'
    };

    (function () {
        const cameraBtn = document.getElementById('pfCameraBtn');
        const fileInput = document.getElementById('pfFileInput');
        const modal = document.getElementById('pfPicModal');
        const imgEl = document.getElementById('pfPreviewImg');
        const btnUpload = document.getElementById('pfPicUpload');
        const btnCancel = document.getElementById('pfPicCancel');
        const msg = document.getElementById('pfPicMsg');
        const avatarImg = document.getElementById('pfImg');
        const initials = document.getElementById('pfInitials');
        const MAX_SIZE = 5 * 1024 * 1024;

        let cropper = null, objectUrl = null;

        const token = () => document.querySelector('#pfForm input[name="__RequestVerificationToken"]').value;

        function closeModal() {
            if (cropper) { cropper.destroy(); cropper = null; }
            if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
            modal.hidden = true; msg.textContent = ''; fileInput.value = '';
        }

        cameraBtn.addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', () => {
            const file = fileInput.files[0];
            if (!file) return;
            if (!/^image\/(png|jpeg|webp)$/.test(file.type)) { alert('Use a PNG, JPG or WEBP image.'); fileInput.value = ''; return; }
            if (file.size > MAX_SIZE) { alert('Image must be 5 MB or smaller.'); fileInput.value = ''; return; }

            objectUrl = URL.createObjectURL(file);
            modal.hidden = false;
            imgEl.onload = () => {
                if (cropper) cropper.destroy();
                cropper = new Cropper(imgEl, { aspectRatio: 1, viewMode: 1, dragMode: 'move', autoCropArea: 0.9, background: false });
            };
            imgEl.src = objectUrl;
        });

        btnCancel.addEventListener('click', closeModal);

        btnUpload.addEventListener('click', () => {
            if (!cropper) return;
            const canvas = cropper.getCroppedCanvas({ width: 512, height: 512, fillColor: '#fff', imageSmoothingQuality: 'high' });

            canvas.toBlob(async (blob) => {
                if (!blob) { msg.textContent = 'Could not process image.'; return; }

                btnUpload.disabled = btnCancel.disabled = true;
                btnUpload.textContent = 'Uploading...';
                msg.textContent = '';

                try {
                    const fd = new FormData();
                    fd.append('file', blob, 'profile.jpg');
                    fd.append('__RequestVerificationToken', token());

                    const res = await fetch(window.PF_URLS.updateProfilePicture, { method: 'POST', body: fd });
                    const json = await res.json();

                    if (json.status ?? json.Status) {
                        const p = json.response ?? json.Response;
                        const url = p?.profilePictureUrl ?? p?.ProfilePictureUrl;
                        const src = url ? url + '?v=' + Date.now() : canvas.toDataURL('image/jpeg');

                        avatarImg.src = src;
                        avatarImg.hidden = false;
                        initials.hidden = true;

                        // update sidebar + top bar avatars without a reload
                        document.querySelectorAll('.au-avatar').forEach(a => {
                            a.innerHTML = '<img src="' + src + '" alt="Profile" />';
                        });

                        closeModal();
                    } else {
                        msg.textContent = json.message ?? json.Message ?? 'Update failed.';
                    }
                } catch (e) {
                    msg.textContent = e.message || 'Something went wrong.';
                } finally {
                    btnUpload.disabled = btnCancel.disabled = false;
                    btnUpload.textContent = 'Upload';
                }
            }, 'image/jpeg', 0.9);
        });

        // Optional: call this from a "Remove photo" button. No file means the API removes the picture and deletes it from R2.
        window.pfRemovePicture = async function () {
            const fd = new FormData();
            fd.append('__RequestVerificationToken', token());
            const res = await fetch(window.PF_URLS.updateProfilePicture, { method: 'POST', body: fd });
            const json = await res.json();
            if (json.status ?? json.Status) { avatarImg.hidden = true; initials.hidden = false; }
        };
    })();
</script>

<script src="~/js/user/profile.js" asp-append-version="true"></script>
