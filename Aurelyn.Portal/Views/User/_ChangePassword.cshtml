@model Aurelyn.Portal.Models.ChangePasswordViewModel.ChangePasswordViewModel

<style>
    .cp-field {
        position: relative;
        margin-bottom: 14px;
    }

        .cp-field .f-icon, .cp-field .pw-toggle svg {
            stroke: #6b69c9;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .cp-field .f-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            width: 17px;
            height: 17px;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .cp-field .au-input {
            height: 46px;
            padding: 0 44px 0 42px;
            border-radius: 15px;
        }

        .cp-field .pw-toggle {
            position: absolute;
            right: 7px;
            top: 50%;
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            cursor: pointer;
        }

            .cp-field .pw-toggle svg {
                width: 17px;
                height: 17px;
            }

            .cp-field .pw-toggle .eye-off {
                display: none;
            }

            .cp-field .pw-toggle.password-visible .eye-on {
                display: none;
            }

            .cp-field .pw-toggle.password-visible .eye-off {
                display: block;
            }

    .cp-strength {
        display: flex;
        gap: 6px;
        align-items: center;
        margin: -4px 2px 14px;
    }

        .cp-strength .bar {
            flex: 1;
            height: 5px;
            border-radius: 4px;
            background: #e3e5f5;
            transition: background .2s;
        }

    #strengthLabel {
        min-width: 42px;
        text-align: right;
        font-size: 10px;
        font-weight: 800;
    }

    .cp-hint {
        margin: 0 2px 18px;
        font-size: 10px;
        color: var(--au-muted);
    }
</style>

<form asp-controller="User" asp-action="ChangePassword" method="post" id="changePasswordForm" novalidate>
    <div class="cp-field">
        <svg class="f-icon" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
        <input type="password" name="CurrentPassword" id="cpCurrent" class="au-input" placeholder="Current password" autocomplete="current-password" />
        <button type="button" class="pw-toggle" data-toggle-password="cpCurrent" aria-label="Show password" aria-pressed="false">
            <svg class="eye-on" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
            <svg class="eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6C3.7 8.5 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 4.4-1M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
        </button>
    </div>

    <div class="cp-field">
        <svg class="f-icon" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4" /><path d="m11 12 9-9M16 7l3 3" /></svg>
        <input type="password" name="NewPassword" id="cpNew" class="au-input" placeholder="New password" autocomplete="new-password" oninput="updateStrength(this.value)" />
        <button type="button" class="pw-toggle" data-toggle-password="cpNew" aria-label="Show password" aria-pressed="false">
            <svg class="eye-on" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
            <svg class="eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6C3.7 8.5 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 4.4-1M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
        </button>
    </div>
    <div class="cp-strength" aria-live="polite">
        <span class="bar" id="s1"></span><span class="bar" id="s2"></span><span class="bar" id="s3"></span><span class="bar" id="s4"></span>
        <span id="strengthLabel"></span>
    </div>

    <div class="cp-field">
        <svg class="f-icon" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2.5" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
        <input type="password" name="ConfirmPassword" id="cpConfirm" class="au-input" placeholder="Confirm new password" autocomplete="new-password" />
        <button type="button" class="pw-toggle" data-toggle-password="cpConfirm" aria-label="Show password" aria-pressed="false">
            <svg class="eye-on" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
            <svg class="eye-off" viewBox="0 0 24 24"><path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6C3.7 8.5 2 12 2 12s3.5 7 10 7a9.7 9.7 0 0 0 4.4-1M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
        </button>
    </div>
    <p class="cp-hint">Use at least 8 characters with an uppercase letter, a number and a symbol.</p>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="au-btn au-btn-secondary" onclick="closePopup()">Cancel</button>
        <button type="submit" class="au-btn au-btn-primary" id="cpSubmit">Update password</button>
    </div>
</form>

<script>
    $(document).off("submit.cp").on("submit.cp", "#changePasswordForm", function (e) {
        e.preventDefault();
        var $form = $(this), $btn = $("#cpSubmit");
        var cur = $("#cpCurrent").val(), np = $("#cpNew").val(), cf = $("#cpConfirm").val();

        if (!cur) return showError("Enter your current password.");
        if (!np) return showError("Enter a new password.");
        if (np.length < 8) return showError("New password must be at least 8 characters.");
        if (np === cur) return showError("New password must be different from the current one.");
        if (np !== cf) return showError("New password and confirmation do not match.");

        setButtonLoading($btn, true, "Updating...");
        ajaxPost($form.attr("action"), $form.serialize(), function (res) {
            setButtonLoading($btn, false);
            if (res && res.status) {
                showSuccess(res.message || "Password updated.");
                closePopup();
            } else {
                showError((res && res.message) || "Could not update the password.");
            }
        }, function () {
            setButtonLoading($btn, false);
            showError("Request failed. Please try again.");
        });
    });
</script>
