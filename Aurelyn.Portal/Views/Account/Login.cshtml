}

<!-- AUTH TABS -->
<div class="auth-tabs" role="tablist">
    <button type="button" class="auth-tab active" role="tab" aria-selected="true" onclick="showAuthTab('signin', this)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-lock"></use></svg>
        Sign in
    </button>
    <button type="button" class="auth-tab" role="tab" aria-selected="false" onclick="showAuthTab('signup', this)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><use href="#i-userplus"></use></svg>
        Sign up
    </button>
</div>

<!-- SIGN IN -->
<div id="signin" class="auth-pane active">
    <h2 class="auth-title">Welcome Back!</h2>
    <p class="auth-sub">Sign in to your <strong>Aurelyn Care</strong> account</p>

    <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" data-auth-form novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="auth-field">
            <svg class="f-icon" viewBox="0 0 24 24"><use href="#i-mail"></use></svg>
            <input asp-for="Email" type="email" class="au-input" placeholder="Email address" autocomplete="username" data-label="Email address" required />
        </div>

        <div class="auth-field">
            <svg class="f-icon" viewBox="0 0 24 24"><use href="#i-lock"></use></svg>
            <input asp-for="Password" type="password" id="loginPassword" class="au-input" placeholder="Password" autocomplete="current-password" data-label="Password" required />
            <button type="button" class="pw-toggle" onclick="toggleAuthPassword('loginPassword', this)" aria-label="Show password">
                <svg class="eye-on" viewBox="0 0 24 24"><use href="#i-eye-on"></use></svg>
                <svg class="eye-off" viewBox="0 0 24 24"><use href="#i-eye-off"></use></svg>
            </button>
        </div>

        <div class="auth-row">
            <label class="auth-check">
                @* <input type="checkbox" name="RememberMe" value="true" />
                <span>Remember me</span> *@
            </label>
            <a asp-controller="Account" asp-action="ResetPassword" class="auth-link">
                Forgot password?
            </a>
        </div>

        <button type="submit" id="loginBtn" class="au-btn au-btn-primary auth-btn">
            <span>Sign in</span>
            <span class="arrow"><svg viewBox="0 0 24 24"><use href="#i-arrow"></use></svg></span>
        </button>
    </form>

    <div class="auth-divider">or continue with</div>

    <button type="button" class="au-btn au-btn-secondary auth-btn-google"
            onclick="showInfo('Google sign-in is not enabled yet.')">
        <svg viewBox="0 0 24 24"><use href="#i-google"></use></svg>
        Continue with Google
    </button>

    <div class="auth-foot">
        Don't have an account?
        <button type="button" class="auth-link" onclick="showAuthTab('signup', document.querySelectorAll('.auth-tab')[1])">Sign up</button>
    </div>
</div>

<!-- SIGN UP -->
<div id="signup" class="auth-pane">
    <h2 class="auth-title">Create Account</h2>
    <p class="auth-sub">Join <strong>Aurelyn Care</strong> and manage your health.</p>

    <form asp-controller="Account" asp-action="Register" method="post" id="registerForm" novalidate>
        <div class="auth-name-row">
            <div class="auth-field">
                <svg class="f-icon" viewBox="0 0 24 24"><use href="#i-user"></use></svg>
                <input type="text" name="FirstName" class="au-input" placeholder="First name" autocomplete="given-name" data-label="First name" required />
            </div>
            <div class="auth-field no-icon">
                <input type="text" name="LastName" class="au-input" placeholder="Last name" autocomplete="family-name" data-label="Last name" required />
            </div>
        </div>

        <div class="auth-field">
            <svg class="f-icon" viewBox="0 0 24 24"><use href="#i-mail"></use></svg>
            <input type="email" name="Email" class="au-input" placeholder="Email address" autocomplete="email" data-label="Email address" required />
        </div>

        <div class="auth-field">
            <svg class="f-icon" viewBox="0 0 24 24"><use href="#i-lock"></use></svg>
            <input type="password" id="signupPassword" name="Password" class="au-input" placeholder="Create password" autocomplete="new-password" data-label="Password" required />
            <button type="button" class="pw-toggle" onclick="toggleAuthPassword('signupPassword', this)" aria-label="Show password">
                <svg class="eye-on" viewBox="0 0 24 24"><use href="#i-eye-on"></use></svg>
                <svg class="eye-off" viewBox="0 0 24 24"><use href="#i-eye-off"></use></svg>
            </button>
        </div>

        <div class="auth-field">
            <svg class="f-icon" viewBox="0 0 24 24"><use href="#i-lock"></use></svg>
            <input type="password" id="confirmPassword" name="ConfirmPassword" class="au-input" placeholder="Confirm password" autocomplete="new-password" data-match="#signupPassword" data-label="Confirm password" required />
            <button type="button" class="pw-toggle" onclick="toggleAuthPassword('confirmPassword', this)" aria-label="Show password">
                <svg class="eye-on" viewBox="0 0 24 24"><use href="#i-eye-on"></use></svg>
                <svg class="eye-off" viewBox="0 0 24 24"><use href="#i-eye-off"></use></svg>
            </button>
        </div>
        <p class="lg-hint">Use 8+ characters with a mix of letters, numbers and symbols.</p>

        <button type="submit" class="au-btn au-btn-primary auth-btn">
            <span>Create account</span>
            <span class="arrow"><svg viewBox="0 0 24 24"><use href="#i-arrow"></use></svg></span>
        </button>
        <p class="lg-terms">By creating an account you agree to our Terms of Service and Privacy Policy.</p>
    </form>

    <div class="auth-foot">
        Already have an account?
        <button type="button" class="auth-link" onclick="showAuthTab('signin', document.querySelectorAll('.auth-tab')[0])">Sign in</button>
    </div>
</div>

<div class="lg-secure">
    <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><path d="m9 12 2 2 4-4" /></svg>
    Your data is encrypted and secure
</div>


@section Scripts {
    <script src="~/js/auth/register.js" asp-append-version="true"></script>
    <script src="~/js/auth/login.js" asp-append-version="true"></script>
    <script>
        function showAuthTab(tabId, button) {

            document.querySelectorAll('.auth-pane').forEach(function (p) {
                p.classList.remove('active');
            });

            document.querySelectorAll('.auth-tab').forEach(function (t) {
                t.classList.remove('active');
                t.setAttribute('aria-selected', 'false');
            });

            var pane = document.getElementById(tabId);

            if (pane) {
                pane.classList.add('active');
            }

            if (button) {
                button.classList.add('active');
                button.setAttribute('aria-selected', 'true');
            }
        }

        function toggleAuthPassword(inputId, button) {

            var input = document.getElementById(inputId);

            if (!input) return;

            var isPassword = input.type === 'password';

            input.type = isPassword ? 'text' : 'password';

            button.classList.toggle('password-visible', isPassword);

            button.setAttribute(
                'aria-label',
                isPassword ? 'Hide password' : 'Show password'
            );
        }

        $(function () {

            if (location.hash === '#signup') {
                showAuthTab('signup', document.querySelectorAll('.auth-tab')[1]);
            }

        });
    </script>
}