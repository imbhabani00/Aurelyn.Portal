        <path d="M0 105C130 65 240 140 360 108S530 72 600 100V150H0Z" fill="#8175ff" opacity=".20" />
    </svg>

    <div class="lg-stage">
        <svg class="lg-art" viewBox="0 0 440 380" role="img" aria-label="Stethoscope and heart illustration">
            <defs>
                <linearGradient id="lgP" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9f9bff" /><stop offset="1" stop-color="#4b47cc" /></linearGradient>
                <linearGradient id="lgH" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#aeaaff" /><stop offset="1" stop-color="#5f5be4" /></linearGradient>
