@model Aurelyn.Portal.Models.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
    ViewData["CardClass"] = "is-login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <style>
        /* ===== wider card + hero panel ===== */
        .auth-card.is-login {
            width: min(1120px, 100%);
            min-height: 660px;
            grid-template-columns: minmax(0,1.12fr) minmax(0,.88fr);
            gap: 18px;
            padding: 18px;
            border-radius: 38px;
            margin-left: 4px;
        }

        .is-login .auth-hero {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            padding: 28px 30px 32px;
            border-radius: 30px;
            background: linear-gradient(145deg, #101426 0%, #151b35 55%, #10172b 100%);
            border: 1px solid rgba(129, 117, 255, .25);
            box-shadow: inset 0 0 35px rgba(98, 91, 255, .08), 0 0 30px rgba(98, 91, 255, .08);
        }

            .is-login .auth-hero::before {
                content: "";
                position: absolute;
                z-index: -1;
                top: -120px;
                right: -100px;
                width: 360px;
                height: 360px;
                border-radius: 50%;
                background: radial-gradient(circle, #fff 0%, rgba(255,255,255,0) 70%);
            }

        .lg-wave {
            position: absolute;
            z-index: -1;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 150px;
            pointer-events: none;
        }

        .lg-stage {
            position: relative;
            flex: 1;
            display: grid;
            place-items: center;
            min-height: 310px;
            margin: 4px 0 6px;
        }

        .lg-art {
            width: min(100%, 440px);
            height: auto;
            filter: drop-shadow(0 18px 28px rgba(110, 95, 255, .25));
            animation: lgFloat 7s ease-in-out infinite;
        }

        .lg-chip {
            position: absolute;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 15px 9px 10px;
            border-radius: 17px;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
            animation: lgFloat 5.5s ease-in-out infinite;
            border: 1px solid rgba(129, 117, 255, .30);
            background: linear-gradient(145deg, #1b2340, #121a30);
            box-shadow: 0 8px 25px rgba(0, 0, 0, .35);
            color: #f0f1ff;
        }

            .lg-chip i {
                width: 30px;
                height: 30px;
                display: grid;
                place-items: center;
                border-radius: 10px;
                color: var(--au-primary);
                background: #e9eaff;
                box-shadow: inset 2px 2px 5px #d3d6f5, inset -2px -2px 5px #fff;
            }

            .lg-chip svg {
                width: 16px;
                height: 16px;
                stroke: currentColor;
                fill: none;
                stroke-width: 1.9;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

            .lg-chip small {
                display: block;
                margin-top: 1px;
                font-size: 9px;
                font-weight: 600;
                color: var(--au-muted);
            }

            .lg-chip.c1 {
                top: 4%;
                right: -4px;
                animation-delay: -1s;
            }

            .lg-chip.c2 {
                bottom: 14%;
                left: -6px;
                animation-delay: -2.6s;
            }

            .lg-chip.c3 {
                bottom: 0;
                right: 2%;
                animation-delay: -4.2s;
            }

        .is-login .auth-hero h1 {
            font-size: 36px;
        }

        .is-login .auth-hero p {
            max-width: 360px;
            font-size: 13px;
        }

        /* ===== form panel ===== */
        .is-login .auth-panel {
            padding: 38px 40px 28px;
            border-radius: 30px;
        }

        .is-login .auth-title {
            text-align: left;
            font-size: 26px;
            letter-spacing: -.4px;
        }

        .is-login .auth-sub {
            text-align: left;
            margin-bottom: 22px;
        }

        .is-login .auth-pane.active {
            animation: lgIn .35s ease;
        }

        .lg-hint {
            margin: -6px 2px 16px;
            font-size: 10px;
            color: var(--au-muted);
        }

        .lg-terms {
            margin: 14px 4px 0;
            text-align: center;
            font-size: 10px;
            line-height: 1.6;
            color: var(--au-muted);
        }

        .lg-secure {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            margin-top: auto;
            padding-top: 22px;
            font-size: 10px;
            font-weight: 600;
            color: var(--au-muted);
        }

            .lg-secure svg {
                width: 14px;
                height: 14px;
                stroke: #20ad8a;
                fill: none;
                stroke-width: 2;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        /* ===== fit to screen on laptop / desktop (no page scroll) ===== */
        @@media (min-width: 961px) {
            html, body {
                height: 100%;
                overflow: hidden;
            }

            .auth-page {
                height: 100vh;
                height: 100dvh;
                min-height: 0;
                padding: 16px;
            }

            .auth-card.is-login {
                height: 100%;
                max-height: 720px;
                min-height: 0;
            }

            .is-login .auth-hero {
                min-height: 0;
                padding: clamp(18px,3.2vh,28px) clamp(20px,2.4vw,30px);
            }

            .lg-stage {
                min-height: 0;
                margin: 0;
            }

            .lg-art {
                width: auto;
                max-width: 100%;
                height: min(46vh, 380px);
            }

            .is-login .auth-hero h1 {
                font-size: clamp(26px, 4.6vh, 36px);
            }

            .is-login .auth-panel {
                padding: clamp(18px,3.4vh,38px) clamp(24px,3vw,40px) clamp(14px,2vh,26px);
            }

            .is-login .auth-tabs {
                margin-bottom: clamp(12px,2.2vh,22px);
            }

            .is-login .auth-title {
                font-size: clamp(21px, 3.4vh, 26px);
            }

            .is-login .auth-sub {
                margin-bottom: clamp(10px,2.2vh,22px);
            }

            .is-login .auth-field {
                margin-bottom: clamp(10px,1.9vh,16px);
            }

                .is-login .auth-field .au-input {
                    height: clamp(40px, 5.8vh, 48px);
                }

            .is-login .auth-btn {
                height: clamp(42px, 6vh, 50px);
            }

            .is-login .auth-btn-google {
                height: clamp(40px, 5.6vh, 48px);
            }

            .is-login .auth-divider {
                margin: clamp(10px,1.8vh,16px) 0;
            }

            .is-login .auth-foot {
                margin-top: clamp(10px,1.8vh,18px);
            }

            .lg-secure {
                padding-top: clamp(10px,1.8vh,22px);
            }
        }

        @@media (min-width: 961px) and (max-height: 760px) {
            .is-login .auth-hero p, .lg-hint, .lg-terms {
                display: none;
            }

            .lg-chip {
                padding: 6px 12px 6px 8px;
            }
        }

        @@media (min-width: 961px) and (max-height: 600px) {
            html, body {
                overflow: auto;
            }

            .auth-page {
                height: auto;
                min-height: 100vh;
            }

            .auth-card.is-login {
                height: auto;
            }
        }

        @@keyframes lgFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }
        }

        @@keyframes lgIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .lg-art, .lg-chip, .is-login .auth-pane.active {
                animation: none;
            }
        }

        @@media (max-width: 960px) {
            .auth-card.is-login {
                grid-template-columns: 1fr;
                min-height: 0;
            }

            .is-login .auth-hero {
                align-items: center;
                padding: 22px 20px 26px;
                text-align: center;
            }

            .lg-stage {
                min-height: 0;
            }

            .lg-art {
                width: min(100%, 300px);
            }

            .lg-chip {
                display: none;
            }

            .is-login .auth-hero h1 {
                font-size: 27px;
            }

            .is-login .auth-hero p {
                margin-left: auto;
                margin-right: auto;
            }
        }

        @@media (max-width: 480px) {
            .auth-card.is-login {
                padding: 10px;
                border-radius: 26px;
            }

            .is-login .auth-panel {
                padding: 26px 18px 22px;
            }

            .is-login .auth-hero p {
                display: none;
            }

            .lg-art {
                width: 230px;
            }
        }
    </style>
}

