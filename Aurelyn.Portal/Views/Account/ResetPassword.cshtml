@model Aurelyn.Portal.Models.User.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<style>
    .auth-card{
        margin-left:20px;
    }
</style>

@section Hero {
    <svg class="auth-art" viewBox="0 0 240 210" aria-hidden="true"><use href="#art-mail" /></svg>
    <h1>Reset <span>Password</span></h1>
    <p>Enter your registered email address and we'll send you a code to set a new password.</p>
}

<h2 class="auth-title">Reset Password</h2>
<p class="auth-sub" id="resetSub">We'll email a 6-digit code to your registered address.</p>

<!-- STEP 1: request code -->
<form asp-controller="Account" asp-action="SendResetCode" method="post" id="sendCodeForm" novalidate>
    <div class="auth-field">
        <svg class="f-icon"><use href="#i-mail" /></svg>
        <input type="email" name="Email" id="resetEmail" class="au-input" placeholder="Email address" autocomplete="email" data-label="Email" required />
    </div>
    <button type="submit" class="au-btn au-btn-primary auth-btn">
        <svg class="lead"><use href="#i-send" /></svg>&nbsp;Send Reset Code
    </button>
</form>

<!-- STEP 2: code + new password -->
<form asp-controller="Account" asp-action="ResetPassword" method="post" id="resetForm" novalidate style="display:none">
    <input type="hidden" name="Email" id="resetEmailHidden" />

    <div class="auth-field no-icon">
        <input type="text" name="Code" class="au-input code-input" inputmode="numeric" maxlength="6" placeholder="6-digit code" autocomplete="one-time-code" data-label="Code" required />
    </div>
    <div class="auth-field">
        <svg class="f-icon"><use href="#i-lock" /></svg>
        <input type="password" name="NewPassword" id="rpNew" class="au-input" placeholder="New password" autocomplete="new-password" data-label="New password" required />
        <button type="button" class="pw-toggle" data-toggle-password="rpNew" aria-label="Show password" aria-pressed="false">
            <svg class="eye-on"><use href="#i-eye-on" /></svg><svg class="eye-off"><use href="#i-eye-off" /></svg>
        </button>
    </div>
    <div class="auth-field">
        <svg class="f-icon"><use href="#i-lock" /></svg>
        <input type="password" name="ConfirmPassword" id="rpConfirm" class="au-input" placeholder="Confirm new password" autocomplete="new-password" data-match="#rpNew" data-label="Confirm password" required />
        <button type="button" class="pw-toggle" data-toggle-password="rpConfirm" aria-label="Show password" aria-pressed="false">
            <svg class="eye-on"><use href="#i-eye-on" /></svg><svg class="eye-off"><use href="#i-eye-off" /></svg>
        </button>
    </div>
    <button type="submit" class="au-btn au-btn-primary auth-btn">
        Reset password
        <span class="arrow"><svg><use href="#i-arrow" /></svg></span>
    </button>
    <p class="auth-foot">Didn't get a code? <button type="button" class="auth-link" id="useAnotherEmail">Send again</button></p>
</form>

<a asp-controller="Account" asp-action="Login" class="auth-back"><svg><use href="#i-back" /></svg>Back to Login</a>
@section Scripts {
    <script src="~/js/auth/resetpassword.js" asp-append-version="true"></script>
}